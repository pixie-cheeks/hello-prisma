model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  jobTitle String
  posts    Post[]
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  published Boolean @default(true)
  authorId  Int
  author    User    @relation(fields: [authorId], references: [id])
}
