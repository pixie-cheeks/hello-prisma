{
  "version": "0.2",
  "language": "en,en-GB,lorem",
  "allowCompoundWords": true,
  "enableGlobDot": true,
  "dictionaries": ["html"],
  "useGitignore": true,
  "words": [
    "aiven",
    "aivenv",
    "awmottaz",
    "besthyhy",
    "Bulbasaur",
    "closedby",
    "dbname",
    "ejslint",
    "fkey",
    "pkey",
    "esbuild",
    "Golubev",
    "ilike",
    "Oopsie",
    "pgdatabase",
    "pghost",
    "pguser",
    "psql",
    "Psyduck",
    "unrs",
    "Vecteezy",
  ],
  "ignorePaths": [
    ".env",
    ".env.*",
    ".git",
    ".husky/_",
    "dist",
    "node_modules",
    "pnpm-lock.yaml",
    "generated",
  ],
}
